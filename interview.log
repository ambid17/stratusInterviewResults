{"event":"pre-tool-use","timestamp":"2026-10-13T18:29:32.846Z","tool_name":"Write","tool_input":{"file_path":"C:\\Users\\ambid\\Documents\\GitHub\\senior-full-stack-with-unity-ai-code-challenge\\unity\\StratusFieldLink\\Assets\\StratusFieldLink\\Runtime\\Net\\PublishService.cs","content":"using System;\nusing System.Collections;\nusing UnityEngine;\nusing StratusFieldLink.Config;\nusing StratusFieldLink.Geometry;\nusing StratusFieldLink.Model;\n\nnamespace StratusFieldLink.Net\n{\n    public enum PublishOutcome\n    {\n        None = 0,\n        Succeeded = 1,\n        RejectedByServer = 2,\n        QueuedOffline = 3,\n        FailedLocalValidation = 4\n    }\n\n    public struct PublishResult\n    {\n        public PublishOutcome Outcome;\n        public string Message;\n        public long StatusCode;\n\n        public bool IsSuccess\n        {\n            get { return Outcome == PublishOutcome.Succeeded; }\n        }\n    }\n\n    /// <summary>\n    /// Owns the client-to-cloud path for a sketch: validate, send, and decide what\n    /// happens when the send does not land.\n    ///\n    /// The sketch id is client-generated and the server treats a repeat of the same\n    /// id + content as a no-op (200), so resending is always safe. That gives:\n    ///   2xx                  done; drop any queued copy\n    ///   no signal / timeout  queue it, the drain sends it later\n    ///   5xx, 408, 429        retry a few times with backoff, then queue it\n    ///   other 4xx            the sketch is wrong; tell the foreman, never resend\n    /// </summary>\n    public sealed class PublishService : MonoBehaviour\n    {\n        public const string PublishPath = \"/api/sketches\";\n\n        public const float MaxDrainIntervalSeconds = 300f;\n\n        /// <summary>Swap this in tests. Defaults to a real UnityWebRequest transport.</summary>\n        public IFieldLinkTransport Transport { get; set; }\n\n        public PublishQueue Queue { get; private set; }\n\n        public PublishResult LastResult { get; private set; }\n\n        public bool IsBusy { get; private set; }\n\n        /// <summary>Sends per sketch before a transient server failure is handed to the queue.</summary>\n        public int MaxAttempts { get; set; }\n\n        /// <summary>Wait before the first retry; doubles on each one after.</summary>\n        public float RetryDelaySeconds { get; set; }\n\n        /// <summary>When false nothing drains the queue unless DrainQueue is called.</summary>\n        public bool AutoDrain { get; set; }\n\n        /// <summary>Gap between drain attempts; doubles while they keep failing, up to MaxDrainIntervalSeconds.</summary>\n        public float DrainIntervalSeconds { get; set; }\n\n        public event Action<PublishResult> PublishCompleted;\n\n        private float _nextDrainAt;\n        private float _drainInterval;\n\n        public PublishService()\n        {\n            MaxAttempts = 3;\n            RetryDelaySeconds = 1f;\n            AutoDrain = true;\n            DrainIntervalSeconds = 15f;\n        }\n\n        private void Awake()\n        {\n            if (Transport == null)\n            {\n                Transport = new UnityWebRequestTransport();\n            }\n\n            if (Queue == null)\n            {\n                Queue = new PublishQueue();\n                Queue.Load();\n            }\n        }\n\n        private void Update()\n        {\n            if (!AutoDrain || IsBusy || Queue == null || Queue.Count == 0)\n            {\n                return;\n            }\n\n            if (Time.realtimeSinceStartup < _nextDrainAt)\n            {\n                return;\n            }\n\n            StartCoroutine(DrainQueue());\n        }\n\n        public Coroutine Publish(FieldSketchDto sketch)\n        {\n            return StartCoroutine(PublishRoutine(sketch));\n        }\n\n        public IEnumerator PublishRoutine(FieldSketchDto sketch)\n        {\n            IsBusy = true;\n\n            var validation = SketchValidation.Validate(sketch);\n            if (!validation.IsValid)\n            {\n                Complete(new PublishResult\n                {\n                    Outcome = PublishOutcome.FailedLocalValidation,\n                    Message = validation.Message\n                });\n                yield break;\n            }\n\n            var result = default(PublishResult);\n            yield return SendRoutine(sketch, r => result = r);\n\n            if (result.Outcome == PublishOutcome.QueuedOffline)\n            {\n                // Queue a copy: the foreman can keep editing this sketch, and resending\n                // an edited run under an id that may already have landed is a 409.\n                Queue.Enqueue(JsonUtility.FromJson<FieldSketchDto>(JsonUtility.ToJson(sketch)));\n                Queue.Save();\n                ScheduleDrain(DrainIntervalSeconds);\n            }\n            else\n            {\n                if (Queue.Remove(sketch.id))\n                {\n                    Queue.Save();\n                }\n\n                if (result.IsSuccess)\n                {\n                    // Signal is evidently back; send whatever else is waiting.\n                    ScheduleDrain(0f);\n                }\n            }\n\n            Complete(result);\n        }\n\n        /// <summary>\n        /// Sends queued sketches oldest first. Stops at the first one that still\n        /// cannot reach the server; drops any the server refuses outright so one bad\n        /// sketch cannot block the rest.\n        /// </summary>\n        public IEnumerator DrainQueue()\n        {\n            if (IsBusy || Queue == null || Queue.Count == 0)\n            {\n                yield break;\n            }\n\n            IsBusy = true;\n\n            var sent = 0;\n            var rejected = 0;\n            var lastRejection = default(PublishResult);\n            var stalled = default(PublishResult);\n\n            while (Queue.Count > 0)\n            {\n                var sketch = Queue.Peek();\n\n                var result = default(PublishResult);\n                yield return SendRoutine(sketch, r => result = r);\n\n                if (result.Outcome == PublishOutcome.QueuedOffline)\n                {\n                    stalled = result;\n                    break;\n                }\n\n                Queue.Remove(sketch.id);\n                Queue.Save();\n\n                if (result.IsSuccess)\n                {\n                    sent++;\n                }\n                else\n                {\n                    rejected++;\n                    lastRejection = result;\n                    Notify(result);\n                }\n            }\n\n            var isStalled = stalled.Outcome == PublishOutcome.QueuedOffline;\n            _drainInterval = isStalled\n                ? Mathf.Min(Mathf.Max(_drainInterval, DrainIntervalSeconds) * 2f, MaxDrainIntervalSeconds)\n                : DrainIntervalSeconds;\n            _nextDrainAt = Time.realtimeSinceStartup + _drainInterval;\n\n            var message = \"Sent \" + sent + \" queued sketch\" + (sent == 1 ? \"\" : \"es\") + \".\";\n            if (rejected > 0)\n            {\n                message += \" \" + lastRejection.Message;\n            }\n\n            if (isStalled)\n            {\n                message += \" \" + Queue.Count + \" still pending.\";\n            }\n\n            Complete(new PublishResult\n            {\n                Outcome = rejected > 0\n                    ? PublishOutcome.RejectedByServer\n                    : isStalled ? PublishOutcome.QueuedOffline : PublishOutcome.Succeeded,\n                Message = message,\n                StatusCode = rejected > 0 ? lastRejection.StatusCode : stalled.StatusCode\n            });\n        }\n\n        /// <summary>\n        /// One sketch, up to MaxAttempts sends. Reports QueuedOffline when the sketch\n        /// should be kept and tried again later; the caller owns the queue.\n        /// </summary>\n        private IEnumerator SendRoutine(FieldSketchDto sketch, Action<PublishResult> onDone)\n        {\n            sketch.clientLengthFeet = SketchGeometry.TotalLengthFeet(sketch.nodes);\n            sketch.clientVersion = FieldLinkConfig.ClientVersion;\n\n            var json = JsonUtility.ToJson(sketch);\n            var url = FieldLinkConfig.Url(PublishPath);\n\n            var response = default(TransportResponse);\n            var delay = RetryDelaySeconds;\n\n            for (var attempt = 1; ; attempt++)\n            {\n                yield return Transport.PostJson(url, json, r => response = r);\n\n                if (!IsTransient(response) || attempt >= MaxAttempts)\n                {\n                    break;\n                }\n\n                Debug.LogWarning(\"[FieldLink] publish \" + sketch.id + \" got \" + response.StatusCode +\n                                 \", retrying (\" + attempt + \"/\" + MaxAttempts + \")\");\n\n                if (delay > 0f)\n                {\n                    yield return new WaitForSecondsRealtime(delay);\n                    delay *= 2f;\n                }\n            }\n\n            onDone(Classify(sketch, response));\n        }\n\n        // A server that answered but may answer differently next time. No signal is\n        // not in here on purpose: retrying a 10s timeout in a basement just freezes\n        // the HUD, so that goes straight to the queue.\n        private static bool IsTransient(TransportResponse response)\n        {\n            if (response.IsNetworkError || response.IsSuccess)\n            {\n                return false;\n            }\n\n            var code = response.StatusCode;\n            return code < 400 || code >= 500 || code == 408 || code == 429;\n        }\n\n        private static PublishResult Classify(FieldSketchDto sketch, TransportResponse response)\n        {\n            var result = new PublishResult { StatusCode = response.StatusCode };\n\n            if (response.IsSuccess)\n            {\n                result.Outcome = PublishOutcome.Succeeded;\n                result.Message = response.StatusCode == 200\n                    ? sketch.id + \" was already published.\"\n                    : \"Published \" + sketch.id;\n                return result;\n            }\n\n            if (response.IsNetworkError)\n            {\n                result.Outcome = PublishOutcome.QueuedOffline;\n                result.Message = \"No signal. Saved \" + sketch.id + \"; will send when back online.\";\n                return result;\n            }\n\n            if (IsTransient(response))\n            {\n                result.Outcome = PublishOutcome.QueuedOffline;\n                result.Message = \"Server unavailable (\" + response.StatusCode + \"). Saved \" + sketch.id + \"; will retry.\";\n                return result;\n            }\n\n            Debug.LogWarning(\"[FieldLink] publish \" + sketch.id + \" rejected: \" + response.StatusCode + \" \" + response.Body);\n\n            result.Outcome = PublishOutcome.RejectedByServer;\n            if (response.StatusCode == 409)\n            {\n                result.Message = sketch.id + \" was already published with different content. Start a new sketch.\";\n            }\n            else\n            {\n                var error = ServerError(response.Body);\n                result.Message = string.IsNullOrEmpty(error)\n                    ? \"Server refused \" + sketch.id + \" (\" + response.StatusCode + \").\"\n                    : \"Rejected \" + sketch.id + \": \" + error;\n            }\n\n            return result;\n        }\n\n        private static string ServerError(string body)\n        {\n            if (string.IsNullOrEmpty(body))\n            {\n                return null;\n            }\n\n            try\n            {\n                var parsed = JsonUtility.FromJson<ApiErrorDto>(body);\n                return parsed != null ? parsed.error : null;\n            }\n            catch (ArgumentException)\n            {\n                // A proxy or captive portal answered with something that is not our JSON.\n                return null;\n            }\n        }\n\n        private void ScheduleDrain(float delaySeconds)\n        {\n            _drainInterval = DrainIntervalSeconds;\n            _nextDrainAt = Time.realtimeSinceStartup + delaySeconds;\n        }\n\n        private void Complete(PublishResult result)\n        {\n            LastResult = result;\n            IsBusy = false;\n            Notify(result);\n        }\n\n        private void Notify(PublishResult result)\n        {\n            var handler = PublishCompleted;\n            if (handler != null)\n            {\n                handler(result);\n            }\n        }\n    }\n}\n"}}
{"event":"pre-tool-use","timestamp":"2026-10-13T18:30:02.030Z","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\ambid\\Documents\\GitHub\\senior-full-stack-with-unity-ai-code-challenge\\unity\\StratusFieldLink\\Assets\\StratusFieldLink\\Tests\\PlayMode\\PublishFlowTests.cs","old_string":"            _publisher.Transport = _transport;\n            _publisher.Queue.Clear();\n        }\n\n        [TearDown]\n        public void TearDown()\n        {\n            if (_host != null)\n            {\n                Object.Destroy(_host);\n            }\n        }","new_string":"            _publisher.Transport = _transport;\n            _publisher.RetryDelaySeconds = 0f;\n            _publisher.AutoDrain = false;\n            _publisher.Queue.Clear();\n        }\n\n        [TearDown]\n        public void TearDown()\n        {\n            // The service persists to the real key; do not leave test sketches in it.\n            PlayerPrefs.DeleteKey(PublishQueue.DefaultStorageKey);\n\n            if (_host != null)\n            {\n                Object.Destroy(_host);\n            }\n        }","replace_all":false}}
{"event":"pre-tool-use","timestamp":"2026-10-13T18:30:02.294Z","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\ambid\\Documents\\GitHub\\senior-full-stack-with-unity-ai-code-challenge\\unity\\StratusFieldLink\\Assets\\StratusFieldLink\\Tests\\PlayMode\\PublishFlowTests.cs","old_string":"        // ---------------------------------------------------------------------\n        // TODO(candidate): there is no test here for what happens when the tablet\n        // is offline, when the server says 400, or when the same sketch is\n        // published twice. That is not an oversight in the test file — the\n        // behaviour does not exist yet. See PublishService.PublishRoutine.\n        // ---------------------------------------------------------------------\n    }","new_string":"        [UnityTest]\n        public IEnumerator Publish_WhenOffline_QueuesTheSketchWithoutRetrying()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n            var sketch = Sketch();\n\n            yield return _publisher.PublishRoutine(sketch);\n\n            Assert.AreEqual(PublishOutcome.QueuedOffline, _publisher.LastResult.Outcome);\n            Assert.AreEqual(1, _transport.CallCount);\n            Assert.AreEqual(1, _publisher.Queue.Count);\n            Assert.AreEqual(sketch.id, _publisher.Queue.Peek().id);\n            Assert.IsFalse(_publisher.IsBusy);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_WhenOffline_PersistsTheQueue()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            var reloaded = new PublishQueue();\n            reloaded.Load();\n            Assert.AreEqual(1, reloaded.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_WhenOffline_QueuesASnapshotNotTheLiveSketch()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n            var sketch = Sketch();\n\n            yield return _publisher.PublishRoutine(sketch);\n            sketch.nodes.Add(new SketchNodeDto(new Vector3(36f, 10f, 20f)));\n\n            Assert.AreEqual(2, _publisher.Queue.Peek().nodes.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_WhenServerSays400_ReportsTheServersReasonAndDoesNotQueue()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(400, \"{\\\"error\\\":\\\"Run is too short.\\\"}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.RejectedByServer, _publisher.LastResult.Outcome);\n            Assert.AreEqual(400, _publisher.LastResult.StatusCode);\n            StringAssert.Contains(\"Run is too short.\", _publisher.LastResult.Message);\n            Assert.AreEqual(1, _transport.CallCount);\n            Assert.AreEqual(0, _publisher.Queue.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_When4xxBodyIsNotJson_StillReportsARejection()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(403, \"<html>Forbidden</html>\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.RejectedByServer, _publisher.LastResult.Outcome);\n            StringAssert.Contains(\"403\", _publisher.LastResult.Message);\n            Assert.AreEqual(0, _publisher.Queue.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_WhenIdAlreadyHoldsDifferentContent_ReportsConflictAndDoesNotQueue()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(409, \"{\\\"error\\\":\\\"already published\\\"}\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.RejectedByServer, _publisher.LastResult.Outcome);\n            Assert.AreEqual(409, _publisher.LastResult.StatusCode);\n            Assert.AreEqual(1, _transport.CallCount);\n            Assert.AreEqual(0, _publisher.Queue.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_SameSketchTwice_SecondIsStillASuccess()\n        {\n            var sketch = Sketch();\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(201, \"{}\"));\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(200, \"{}\"));\n\n            yield return _publisher.PublishRoutine(sketch);\n            yield return _publisher.PublishRoutine(sketch);\n\n            Assert.IsTrue(_publisher.LastResult.IsSuccess, _publisher.LastResult.Message);\n            StringAssert.Contains(\"already published\", _publisher.LastResult.Message);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_When5xxThenAccepted_RetriesAndSucceeds()\n        {\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(503, \"\"));\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(201, \"{}\"));\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.IsTrue(_publisher.LastResult.IsSuccess, _publisher.LastResult.Message);\n            Assert.AreEqual(2, _transport.CallCount);\n            Assert.AreEqual(0, _publisher.Queue.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Publish_When5xxPersists_GivesUpAfterMaxAttemptsAndQueues()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Status(503, \"\");\n\n            yield return _publisher.PublishRoutine(Sketch());\n\n            Assert.AreEqual(PublishOutcome.QueuedOffline, _publisher.LastResult.Outcome);\n            Assert.AreEqual(_publisher.MaxAttempts, _transport.CallCount);\n            Assert.AreEqual(1, _publisher.Queue.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Drain_WhenBackOnline_SendsEverythingAndEmptiesTheQueue()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n            var first = Sketch();\n            var second = Sketch();\n            yield return _publisher.PublishRoutine(first);\n            yield return _publisher.PublishRoutine(second);\n\n            _transport.NextResponse = StubFieldLinkTransport.Status(201, \"{}\");\n            yield return _publisher.DrainQueue();\n\n            Assert.AreEqual(0, _publisher.Queue.Count);\n            Assert.AreEqual(4, _transport.CallCount);\n            StringAssert.Contains(first.id, _transport.SentBodies[2]);\n            StringAssert.Contains(second.id, _transport.SentBodies[3]);\n            Assert.IsTrue(_publisher.LastResult.IsSuccess, _publisher.LastResult.Message);\n            Assert.IsFalse(_publisher.IsBusy);\n\n            var reloaded = new PublishQueue();\n            reloaded.Load();\n            Assert.AreEqual(0, reloaded.Count);\n        }\n\n        [UnityTest]\n        public IEnumerator Drain_WhenStillOffline_StopsAtTheFirstSketchAndKeepsThemAll()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n            yield return _publisher.PublishRoutine(Sketch());\n            yield return _publisher.PublishRoutine(Sketch());\n\n            yield return _publisher.DrainQueue();\n\n            Assert.AreEqual(3, _transport.CallCount);\n            Assert.AreEqual(2, _publisher.Queue.Count);\n            Assert.AreEqual(PublishOutcome.QueuedOffline, _publisher.LastResult.Outcome);\n        }\n\n        [UnityTest]\n        public IEnumerator Drain_WhenServerRejectsOne_DropsItTellsTheForemanAndCarriesOn()\n        {\n            _transport.NextResponse = StubFieldLinkTransport.Offline();\n            var bad = Sketch();\n            yield return _publisher.PublishRoutine(bad);\n            yield return _publisher.PublishRoutine(Sketch());\n\n            var rejections = new List<PublishResult>();\n            _publisher.PublishCompleted += r =>\n            {\n                if (r.Outcome == PublishOutcome.RejectedByServer)\n                {\n                    rejections.Add(r);\n                }\n            };\n\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(400, \"{\\\"error\\\":\\\"Run is too short.\\\"}\"));\n            _transport.ScriptedResponses.Enqueue(StubFieldLinkTransport.Status(201, \"{}\"));\n            yield return _publisher.DrainQueue();\n\n            Assert.AreEqual(0, _publisher.Queue.Count);\n            Assert.IsNotEmpty(rejections);\n            StringAssert.Contains(bad.id, rejections[0].Message);\n            StringAssert.Contains(\"Run is too short.\", _publisher.LastResult.Message);\n        }\n    }","replace_all":false}}
