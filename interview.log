{"event":"pre-tool-use","timestamp":"2026-10-13T18:30:19.410Z","tool_name":"Edit","tool_input":{"file_path":"C:\\Users\\ambid\\Documents\\GitHub\\senior-full-stack-with-unity-ai-code-challenge\\unity\\StratusFieldLink\\Assets\\StratusFieldLink\\Runtime\\Net\\PublishService.cs","old_string":"        public int MaxAttempts { get; set; }\n\n        /// <summary>Wait before the first retry; doubles on each one after.</summary>\n        public float RetryDelaySeconds { get; set; }\n\n        /// <summary>When false nothing drains the queue unless DrainQueue is called.</summary>\n        public bool AutoDrain { get; set; }\n\n        /// <summary>Gap between drain attempts; doubles while they keep failing, up to MaxDrainIntervalSeconds.</summary>\n        public float DrainIntervalSeconds { get; set; }\n\n        public event Action<PublishResult> PublishCompleted;\n\n        private float _nextDrainAt;\n        private float _drainInterval;\n\n        public PublishService()\n        {\n            MaxAttempts = 3;\n            RetryDelaySeconds = 1f;\n            AutoDrain = true;\n            DrainIntervalSeconds = 15f;\n        }\n","new_string":"        public int MaxAttempts { get; set; } = 3;\n\n        /// <summary>Wait before the first retry; doubles on each one after.</summary>\n        public float RetryDelaySeconds { get; set; } = 1f;\n\n        /// <summary>When false nothing drains the queue unless DrainQueue is called.</summary>\n        public bool AutoDrain { get; set; } = true;\n\n        /// <summary>Gap between drain attempts; doubles while they keep failing, up to MaxDrainIntervalSeconds.</summary>\n        public float DrainIntervalSeconds { get; set; } = 15f;\n\n        public event Action<PublishResult> PublishCompleted;\n\n        private float _nextDrainAt;\n        private float _drainInterval;\n","replace_all":false}}
